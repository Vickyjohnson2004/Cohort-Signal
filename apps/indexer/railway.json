{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pnpm --filter @cohortsignal/core build && pnpm --filter @cohortsignal/indexer build"
  },
  "deploy": {
    "startCommand": "node apps/indexer/dist/main.js live",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
