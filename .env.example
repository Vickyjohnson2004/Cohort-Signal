# =============================================================================
# CohortSignal — environment variables
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# In production (Railway), set these in the service's variables panel.
# Never commit a real .env file.

# -----------------------------------------------------------------------------
# Postgres (Neon)
# -----------------------------------------------------------------------------
# Pooler URL works fine for the MCP server (read-mostly, short-lived queries).
# For the indexer (writes), prefer the direct (non-pooled) URL.
DATABASE_URL=postgresql://user:password@host:5432/cohortsignal?sslmode=require

# -----------------------------------------------------------------------------
# Redis (Upstash REST)
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me

# -----------------------------------------------------------------------------
# Bitcoin Core RPC (GetBlock free tier)
# -----------------------------------------------------------------------------
# Full URL including the access token, e.g. https://go.getblock.io/<token>/
BITCOIN_RPC_URL=https://go.getblock.io/REPLACE_TOKEN/

# Public Esplora API (no key needed) — used as a fallback and to construct
# the public evidenceURL we attach to every response.
ESPLORA_API_URL=https://blockstream.info/api

# -----------------------------------------------------------------------------
# Google Cloud / BigQuery (historical UTXO flow extract)
# -----------------------------------------------------------------------------
# Path to service-account JSON (relative to repo root), OR set GCP_SA_KEY_JSON
# to the raw JSON string (recommended on Railway).
GOOGLE_APPLICATION_CREDENTIALS=.secrets/gcp-sa.json
GCP_PROJECT_ID=your-gcp-project-id
# GCP_SA_KEY_JSON={"type":"service_account","project_id":"...",...}

# -----------------------------------------------------------------------------
# Pricing source (CoinGecko free public API)
# -----------------------------------------------------------------------------
COINGECKO_API_URL=https://api.coingecko.com/api/v3
# Optional demo key (for higher free-tier rate limits). Leave empty otherwise.
COINGECKO_DEMO_API_KEY=

# -----------------------------------------------------------------------------
# Context Protocol middleware
# -----------------------------------------------------------------------------
# Set to "false" only for local development without Context Protocol auth.
# Production deployments MUST leave this unset (or set to "true").
CONTEXT_AUTH_ENABLED=true

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000
LOG_LEVEL=info
NODE_ENV=development

# -----------------------------------------------------------------------------
# Indexer tuning
# -----------------------------------------------------------------------------
# How often the live-edge indexer polls for new blocks (milliseconds).
INDEXER_POLL_INTERVAL_MS=300000
# Confirmations after which we mark a snapshot as final (no longer provisional).
INDEXER_FINALITY_CONFIRMATIONS=6
# Maximum age (seconds) before a snapshot is flagged with freshnessWarning.
INDEXER_FRESHNESS_WARNING_SECONDS=14400
